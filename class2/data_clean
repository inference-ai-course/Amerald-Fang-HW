# Third-party libraries (Requires: pip install jsonlines datasketch langdetect)
from datasketch import MinHash
from langdetect import detect, DetectorFactory

# Set seed for reproducibility in langdetect (optional, but good practice)
DetectorFactory.seed = 0

# --- GLOBAL CONFIGURATION AND CONSTANTS ---

# List of files to process. Manually update these paths.
INPUT_FILES = [
    "arxiv_clean.json",
    "talks_transcripts.jsonl",
    "pdf_ocr\\arxiv_papers_with_ocr.json",
]

# Output file path for cleaned, deduplicated corpus text
OUTPUT_FILE = "clean_corpus.txt"

# Output file path for cleaning statistics
LOG_FILE = "stats.md"

# Similarity threshold for MinHash deduplication (Jaccard similarity)
SIMILARITY_THRESHOLD = 0.7

# MinHash Parameters
NUM_PERMUTATIONS = 128  # Number of hash functions to use

# Repetitive N-gram Removal Settings
# If a 5-gram is repeated more than this many times in a single document, 
# it's considered boilerplate and is removed.
N_GRAM_LENGTH = 5
MAX_N_GRAM_REPETITION = 5

# Minimum required word count for a record to be considered valid text
MIN_WORDS_REQUIRED = 10 

# Regular expressions for PII removal
PII_PATTERNS = {
    # Simple Email regex (catches most formats)
    'email': r'\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,}\b',
    # Generic Phone number format (supports various delimiters and country codes)
    'phone': r'(\+?\d{1,3}[-. ]?)?\(?\d{3}\)?[-. ]?\d{3}[-. ]?\d{4}\b',
    # Credit Card number (16 digits, with or without spaces/hyphens)
    'credit_card': r'\b(?:\d[ -]*?){13,16}\b',
}

# --- CLEANING AND PROCESSING HELPER FUNCTIONS ---

def count_tokens(records: List[Dict[str, Any]]) -> int:
    """Counts tokens (whitespace separated words) in all 'text' fields."""
    total_tokens = 0
    for record in records:
        text = record.get('text', '')
        # Simple whitespace tokenizer
        total_tokens += len(text.split())
    return total_tokens

def strip_html(text: str) -> str:
    """Removes basic HTML tags from a string."""
    if not isinstance(text, str):
        return ""
    # Regex to find and replace content within angle brackets
    clean = re.compile('<.*?>')
    return re.sub(clean, '', text)

def clean_pii(text: str) -> str:
    """Removes common PII (emails, phones, credit cards) using regex."""
    if not isinstance(text, str):
        return ""
        
    cleaned_text = text
    for name, pattern in PII_PATTERNS.items():
        # Replace matches with a descriptive placeholder
        cleaned_text = re.sub(pattern, f"[{name.upper()}_REDACTED]", cleaned_text)
    return cleaned_text

def remove_repetitive_ngrams(text: str, n: int = N_GRAM_LENGTH, max_repeat: int = MAX_N_GRAM_REPETITION) -> str:
    """
    Identifies the single most frequently repeated n-gram in a document and 
    replaces all its occurrences with a single space to remove boilerplate.
    """
    if not isinstance(text, str) or len(text) < n:
        return text

    # Use a simplified tokenization
    words = text.lower().split()
    
    if len(words) < n:
        return text

    # Generate n-grams and count occurrences
    ngram_counts = {}
    for i in range(len(words) - n + 1):
        ngram = " ".join(words[i:i + n])
        ngram_counts[ngram] = ngram_counts.get(ngram, 0) + 1

    if not ngram_counts:
        return text

    # Find the most common n-gram
    most_common_ngram = max(ngram_counts, key=ngram_counts.get)
    count = ngram_counts[most_common_ngram]

    # Check if the repetition count exceeds the threshold
    if count > max_repeat:
        print(f"    -> Repetitive N-gram detected and removed: '{most_common_ngram}' (Repeated {count} times)")
        # Replace all occurrences of the repetitive sequence with a single space
        return text.replace(most_common_ngram, ' ')
        
    return text

def preprocess_text(text: Any) -> str:
    """Applies all cleaning steps to a text field."""
    if not isinstance(text, str):
        return ""
    
    text = strip_html(text)
    text = clean_pii(text)
    text = remove_repetitive_ngrams(text)
    
    # Remove extra whitespace after all cleaning
    text = re.sub(r'\s+', ' ', text).strip()
    return text

def generate_minhash(text: str) -> MinHash:
    """
    Generates a datasketch MinHash object for a given text using word shingling.
    """
    m = MinHash(num_perm=NUM_PERMUTATIONS)
    # Use word-based shingling (tokenization)
    tokens = text.lower().split()
    for token in tokens:
        # datasketch requires byte objects
        m.update(token.encode('utf8'))
    return m

# --- MAIN PROCESSING LOGIC ---

def deduplicate_and_process(data_records: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    """
    Processes, cleans, and deduplicates records using MinHash.
    """
    
    # FIX: MinHash objects are unhashable. Changed dictionary to a list to store the unique MinHash objects.
    unique_fingerprints: List[MinHash] = [] 
    unique_records: List[Dict[str, Any]] = []
    
    total_processed = 0
    total_deduplicated = 0
    
    print(f"\n--- Starting Deduplication ({NUM_PERMUTATIONS} permutations, Threshold: {SIMILARITY_THRESHOLD}) ---")

    for record in data_records:
        total_processed += 1
        
        # Assume the content is stored in a 'text' field (key standardized in loading)
        text_content = record.get('text', '')
        
        # 1. Apply cleaning/preprocessing
        cleaned_text = preprocess_text(text_content)
        record['text'] = cleaned_text # Update the record with the cleaned text
        
        if not cleaned_text or len(cleaned_text.split()) < MIN_WORDS_REQUIRED:
            # Skip records that are empty or too short after cleaning
            continue

        # 2. Language Detection (Ensures text is in English for consistency)
        try:
            # Only detect language on the first 1000 characters for efficiency
            detected_lang = detect(cleaned_text[:1000])
            if detected_lang != 'en':
                # print(f"    -> Language detected as non-English ({detected_lang}), skipping record {total_processed}.")
                continue
        except Exception:
            # print(f"    -> Warning: Language detection failed or text too noisy for record {total_processed}. Skipping.")
            continue
            
        # 3. Generate MinHash fingerprint
        new_fingerprint = generate_minhash(cleaned_text)
        
        is_duplicate = False
        
        # 4. Check against existing fingerprints
        for fp_candidate in unique_fingerprints:
            # Datasketch MinHash objects provide the Jaccard method
            similarity = new_fingerprint.jaccard(fp_candidate)
            
            if similarity >= SIMILARITY_THRESHOLD:
                total_deduplicated += 1
                is_duplicate = True
                break
                
        if not is_duplicate:
            # Append the unique MinHash object to the list
            unique_fingerprints.append(new_fingerprint)
            unique_records.append(record)
            
        if total_processed % 100 == 0:
            print(f"  -> Processed {total_processed} records. Unique: {len(unique_records)} / Duplicates: {total_deduplicated}")


    print(f"\n--- Deduplication Complete ---")
    print(f"Total Records Processed: {total_processed}")
    print(f"Total Duplicates Removed: {total_deduplicated}")
    print(f"Total Unique Records Kept: {len(unique_records)}")
    
    return unique_records

def _standardize_record_keys(records: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    """
    Transforms records with known nested or multi-field structures into a single 'text' field.
    This function applies explicit rules based on the provided file structures.
    """
    standardized_records: List[Dict[str, Any]] = []
    
    for record in records:
        text_parts = []
        
        # --- Rule 1: Handle Transcript records (nested list of segments) ---
        if 'transcript_segments' in record and isinstance(record['transcript_segments'], list):
            # Concatenate the 'text' key from each dictionary in the list
            for segment in record['transcript_segments']:
                if isinstance(segment, dict) and 'text' in segment and segment['text']:
                    text_parts.append(segment['text'])
        
        # --- Rule 2: Handle ArXiv records (combine full text and abstracts) ---
        # Prioritize full_text_ocr if available and substantial (from pdf_ocr file structure)
        if record.get('full_text_ocr') and isinstance(record['full_text_ocr'], str) and len(record['full_text_ocr'].split()) > MIN_WORDS_REQUIRED:
            text_parts.append(record['full_text_ocr'])
        else:
            # Fallback: Combine available abstract fields (from arxiv_clean and pdf_ocr structures)
            for key in ['abstract', 'abstract_playwright', 'abstract_ocr']:
                text_content = record.get(key)
                if text_content and isinstance(text_content, str) and text_content not in text_parts:
                    text_parts.append(text_content)

        # --- Final assignment: Clean up and store ---
        
        # Join all text parts, filter out any None/empty strings, and use a double newline for separation
        combined_text = '\n\n'.join(filter(None, text_parts)).strip()
        
        # Only keep the record if we successfully extracted substantial text
        if len(combined_text.split()) > MIN_WORDS_REQUIRED: 
            record['text'] = combined_text
            standardized_records.append(record)
        
    print(f"  -> Content key standardization resulted in {len(standardized_records)} records with substantial text.")
    return standardized_records


def load_and_process_files(files: List[str]) -> List[Dict[str, Any]]:
    """Loads records from JSON/JSONL files and standardizes the content key to 'text'."""
    all_records = []
    
    for file_path in files:
        if not os.path.exists(file_path):
            print(f"⚠️ Warning: File not found: {file_path}")
            continue

        print(f"\nLoading file: {file_path}")
        file_records = []
        
        try:
            if file_path.endswith('.jsonl'):
                # Load JSONL file (one JSON object per line)
                with jsonlines.open(file_path, mode='r') as reader:
                    for record in reader:
                        record['file_source'] = file_path
                        file_records.append(record)
                
            elif file_path.endswith('.json'):
                # Load standard JSON file (assumed to contain a list of objects)
                with open(file_path, 'r', encoding='utf-8') as f:
                    data = json.load(f)
                    if isinstance(data, list):
                        for record in data:
                            record['file_source'] = file_path
                            file_records.append(record)
                    else:
                        print(f"  -> Error: JSON file {file_path} does not contain a list of records.")
                        
            else:
                print(f"  -> Skipping file {file_path}: unsupported extension. Must be .json or .jsonl")
            
            print(f"  -> Loaded {len(file_records)} records from {file_path}")
            all_records.extend(file_records)

        except Exception as e:
            print(f"  -> Error loading {file_path}: {e}")

    # NEW STEP: Standardize all loaded records to use the 'text' key based on structure
    all_records = _standardize_record_keys(all_records)
    
    return all_records

def create_corpus_file(records: List[Dict[str, Any]], output_path: str):
    """Concatenates the 'text' field of all records into a single .txt corpus file."""
    print(f"\nSaving {len(records)} unique records to {output_path}...")
    # Concatenate the 'text' field of all records, separated by newlines
    corpus_text = "\n\n---\n\n".join(record.get('text', '') for record in records if record.get('text'))
    
    try:
        with open(output_path, 'w', encoding='utf-8') as f:
            f.write(corpus_text)
        print(f"✅ Successfully created corpus file: {output_path}")
    except Exception as e:
        print(f"❌ Error during corpus saving: {e}")

def log_stats(log_file: str, initial_count: int, final_count: int, initial_tokens: int, final_tokens: int):
    """Writes a summary of cleaning statistics to a Markdown log file."""
    
    # Calculate percentages (handle division by zero if initial counts are zero)
    record_reduction_percent = 0
    token_reduction_percent = 0
    
    if initial_count > 0:
        record_reduction_percent = ((initial_count - final_count) / initial_count) * 100

    if initial_tokens > 0:
        token_reduction_percent = ((initial_tokens - final_tokens) / initial_tokens) * 100
        
    
    log_content = f"""# Data Cleaning and Deduplication Report

| Metric | Initial Value | Final Value | Removal Percentage |
| :--- | :--- | :--- | :--- |
| **Records** | {initial_count:,} | {final_count:,} | {record_reduction_percent:.2f}% |
| **Tokens (Words)** | {initial_tokens:,} | {final_tokens:,} | {token_reduction_percent:.2f}% |

## Cleaning Parameters Used

- **Deduplication Similarity Threshold (MinHash Jaccard):** {SIMILARITY_THRESHOLD}
- **MinHash Permutations:** {NUM_PERMUTATIONS}
- **Repetitive N-Gram Length:** {N_GRAM_LENGTH}
- **Max N-Gram Repetition per Document:** {MAX_N_GRAM_REPETITION}
- **Minimum Words per Document (Post-Cleaning):** {MIN_WORDS_REQUIRED}
"""
    
    try:
        with open(log_file, 'w', encoding='utf-8') as f:
            f.write(log_content)
        print(f"✅ Successfully created statistics log: {log_file}")
    except Exception as e:
        print(f"❌ Error saving log file: {e}")


# --- MAIN WORKFLOW ---

def main():
    """Coordinates the data loading, cleaning, deduplication, and saving process."""
    
    # 1. Load all records from the specified input files (includes key standardization)
    all_records = load_and_process_files(INPUT_FILES)
    initial_record_count = len(all_records)
    
    if not all_records:
        print("🛑 No records loaded. Script finished.")
        # Ensure log file is still created even if empty
        log_stats(LOG_FILE, 0, 0, 0, 0)
        return

    # Calculate tokens *after* key standardization (text is now correctly available)
    initial_token_count = count_tokens(all_records)
    
    print(f"\nTotal records loaded: {initial_record_count}")
    print(f"Initial estimated token count: {initial_token_count:,}")
    
    # 2. Clean and Deduplicate
    unique_and_cleaned_records = deduplicate_and_process(all_records)
    final_record_count = len(unique_and_cleaned_records)
    final_token_count = count_tokens(unique_and_cleaned_records)
    
    # 3. Save the final corpus file. Added a separator '---' between documents for clarity.
    create_corpus_file(unique_and_cleaned_records, OUTPUT_FILE)
    
    # 4. Generate the statistics log
    log_stats(
        LOG_FILE, 
        initial_record_count, 
        final_record_count, 
        initial_token_count, 
        final_token_count
    )

if __name__ == "__main__":
    main()
